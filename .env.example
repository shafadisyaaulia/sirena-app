# === Database ===
# PostgreSQL + TimescaleDB extension direkomendasikan (lihat README §2).
# Contoh: Neon, Supabase, atau Postgres self-hosted dengan extension timescaledb.
DATABASE_URL="postgresql://sirena:sirena@localhost:5432/sirena_app?schema=public"

# === NextAuth ===
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"

# === Sumber Data Curah Hujan ===
BMKG_API_BASE_URL="https://api.bmkg.go.id"
BMKG_API_KEY=""
GPM_HIMAWARI_API_BASE_URL=""
GPM_HIMAWARI_API_KEY=""

# === Notifikasi Multi-kanal (FN-6) ===
# WhatsApp via Twilio (bisa diganti provider WhatsApp Business API resmi)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Gateway USSD lokal (kontrak terpisah — lihat PRD §10)
USSD_GATEWAY_BASE_URL=""
USSD_GATEWAY_API_KEY=""

# Email (opsional, untuk laporan ESG ke mitra CSR)
RESEND_API_KEY=""

# === Sensor Ingest ===
# Token bersama untuk endpoint /api/sensors/ingest dari perangkat IoT/logger di lapangan.
SENSOR_INGEST_TOKEN="ganti-dengan-token-acak-panjang"

# === Ambang Operasional Default (dapat dikonfigurasi ulang via Admin > Konfigurasi) ===
DEFAULT_GATE_CAPACITY_M3S=200
DEFAULT_STORAGE_CAPACITY_M3=3380000
